{
  "name": "artflow-minidesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "qa:seeded": "tauri dev --config src-tauri/tauri.qa.conf.json",
    "qa:clean": "AF_MINIDESK_QA_SCENARIO=clean tauri dev --config src-tauri/tauri.qa.conf.json",
    "qa:seed": "cargo run --manifest-path src-tauri/Cargo.toml --bin qa_seed -- --scenario seeded",
    "qa:seed:clean": "cargo run --manifest-path src-tauri/Cargo.toml --bin qa_seed -- --scenario clean",
    "qa:rebuild": "cargo run --manifest-path src-tauri/Cargo.toml --bin qa_seed -- --scenario seeded --rebuild",
    "layout:check": "node scripts/layout-check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  }
}
