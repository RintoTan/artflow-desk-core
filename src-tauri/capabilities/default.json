{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "miniDesk 最小权限：仅核心窗口与系统文件对话框。无 fs、无 sql、无 shell、无 http。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default"
  ]
}
