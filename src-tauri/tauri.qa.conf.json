{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArtFlow Desk Core QA",
  "identifier": "dev.artflow.minidesk.qa",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1421 --strictPort",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArtFlow Desk Core — QA 测试环境",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/seeded/generations/*/attachments/**",
          "$APPDATA/clean/generations/*/attachments/**"
        ]
      }
    }
  }
}
